<?xml version="1.0" encoding="utf-8"?>
<!--
  暗色主题。
  这份里的颜色取的是之前写死在代码里的那套，所以"暗色"看起来和旧版一致。
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.VideoWall" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vw_accent_dark</item>
        <item name="colorOnPrimary">@color/vw_on_accent</item>
        <item name="colorPrimaryContainer">@color/vw_accent_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/vw_accent_dark</item>
        <item name="colorSurface">@color/vw_card_dark</item>
        <item name="colorOnSurface">@color/vw_text_dark</item>
        <item name="colorSurfaceContainer">@color/vw_card_dark</item>
        <item name="colorSurfaceContainerHigh">@color/vw_card_dark</item>
        <item name="colorOnSurfaceVariant">@color/vw_text2_dark</item>
        <item name="colorOutline">@color/vw_stroke_dark</item>
        <item name="colorError">@color/vw_warn_dark</item>
        <item name="android:colorBackground">@color/vw_bg_dark</item>
        <item name="android:windowBackground">@color/vw_bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="vwBg">@color/vw_bg_dark</item>
        <item name="vwCard">@color/vw_card_dark</item>
        <item name="vwStroke">@color/vw_stroke_dark</item>
        <item name="vwChip">@color/vw_chip_dark</item>
        <item name="vwChipOn">@color/vw_chip_on_dark</item>
        <item name="vwTextPrimary">@color/vw_text_dark</item>
        <item name="vwTextSecondary">@color/vw_text2_dark</item>
        <item name="vwTextTertiary">@color/vw_text3_dark</item>
        <item name="vwAccent">@color/vw_accent_dark</item>
        <item name="vwWarn">@color/vw_warn_dark</item>
        <item name="vwSection">@color/vw_section_dark</item>
    </style>

</resources>
